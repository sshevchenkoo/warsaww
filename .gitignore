# Secrets — never commit. Any .env variant (.env.local, a stray `.env.`, …);
# only the templates are tracked.
.env*
!.env.example
.ssh/
.kube/
# filled-in k8s Secret (keep only secret.example.yml)
**/k8s/secret.yml
# local infra auth gateway (nginx basic-auth + Grafana admin password) — never commit
deploy/local/.htpasswd
deploy/local/secrets.env
# local TLS cert for https://localhost (self-signed, per-machine) — never commit
deploy/local/certs/

# Terraform
*.tfvars
!*.tfvars.example
*.tfstate
*.tfstate.backup
.terraform/
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — it pins provider
# versions/hashes and must be committed for reproducible `terraform init`.

# Python
__pycache__/
*.pyc
*.pyo
*.py[cod]
venv/
.venv/
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# macOS iCloud / Finder conflict copies ("file 2.ext", "Dockerfile 3", …).
# This repo currently lives on an iCloud-synced folder; ignore the duplicates
# it creates so they never pollute git status or get committed.
* [2-9].*
* [2-9]
*.icloud

# IDE
.idea/
.vscode/

# Obsidian notes (local only — may be a directory or a symlink)
notes
notes/

# gstack / browse-skill startup logs
.gstack/

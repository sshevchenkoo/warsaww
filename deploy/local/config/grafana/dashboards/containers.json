{
  "title": "Warsaw — Containers (cAdvisor)",
  "uid": "warsaw-containers",
  "tags": ["warsaw", "containers"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU cores per container",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 3 } },
      "targets": [{ "expr": "label_replace(sum by (id) (rate(container_cpu_usage_seconds_total{id=~\".*docker[-/].*\"}[5m])), \"container\", \"$1\", \"id\", \".*docker[-/]([a-f0-9]{12}).*\")", "legendFormat": "{{container}}" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory per container",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "expr": "label_replace(sum by (id) (container_memory_usage_bytes{id=~\".*docker[-/].*\"}), \"container\", \"$1\", \"id\", \".*docker[-/]([a-f0-9]{12}).*\")", "legendFormat": "{{container}}" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network RX per container",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [{ "expr": "label_replace(sum by (id) (rate(container_network_receive_bytes_total{id=~\".*docker[-/].*\"}[5m])), \"container\", \"$1\", \"id\", \".*docker[-/]([a-f0-9]{12}).*\")", "legendFormat": "{{container}}" }]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Memory now (top containers)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "options": { "showHeader": true },
      "targets": [{ "expr": "topk(10, label_replace(sum by (id) (container_memory_usage_bytes{id=~\".*docker[-/].*\"}), \"container\", \"$1\", \"id\", \".*docker[-/]([a-f0-9]{12}).*\"))", "legendFormat": "{{container}}", "format": "table", "instant": true }]
    }
  ]
}
